rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------------------------------- */
    /* Helpers                                                          */
    /* ---------------------------------------------------------------- */

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperuser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().userType == 'superuser';
    }

    function isApprovedOrganiser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().userType == 'organiser'
        && userDoc().status == 'approved';
    }

    /* Fields a user must never be able to set on themselves. Role escalation,
       account approval, bespoke commission and wallet balances are admin-only. */
    function noPrivilegedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['userType', 'status', 'commissionPercent', 'adminFee', 'wallet',
                 'welcomeBonusGranted']);
    }

    /* ---------------------------------------------------------------- */
    /* users                                                            */
    /* ---------------------------------------------------------------- */

    match /users/{uid} {
      // Your own profile, or an administrator's. Nothing else.
      //
      // This used to carry `|| resource.data.userType == 'organiser'`, which made every
      // approved organiser's FULL user document readable by anyone who could reach
      // Firestore — email, phone, postal address and date of birth, by uid, with no
      // account required. The organiser ids are published in the sitemap, so the set of
      // uids to try was public too.
      //
      // Nothing needed it. `getUserProfile()` is only ever called with the caller's own
      // uid, and the public directory is server-rendered through the Admin SDK
      // projection in backend/services/public-profiles.ts, which returns branding
      // fields only. The clause was a hole with no user.
      allow get: if isSelf(uid) || isSuperuser();

      // Listing is now administrators only. It was `isSignedIn()`, which let anyone who
      // registered a free account enumerate every user on the platform and read the same
      // personal fields in bulk — a worse version of the same leak.
      //
      // The two legitimate readers both moved off this rule: admin screens go through
      // /api/admin/users behind requireAdmin, and the public directory and sitemap use
      // the Admin SDK projection.
      allow list: if isSuperuser();

      // A new profile may only be created by its owner, must claim its own uid, and
      // must not self-assign an elevated role or an approved organiser status.
      allow create: if isSelf(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.userType in ['customer', 'organiser']
                    && (request.resource.data.userType != 'organiser'
                        || request.resource.data.status == 'pending');

      allow update: if isSuperuser()
                    || (isSelf(uid) && noPrivilegedFields());

      allow delete: if isSuperuser();
    }

    /* ---------------------------------------------------------------- */
    /* events                                                           */
    /* ---------------------------------------------------------------- */

    match /events/{eventId} {
      // Published events are public; drafts are visible to their owner and admins.
      allow get, list: if resource == null
                       || resource.data.status == 'published'
                       || isSuperuser()
                       || (isSignedIn() && resource.data.organizerId == request.auth.uid);

      allow create: if isApprovedOrganiser()
                    && request.resource.data.organizerId == request.auth.uid;

      allow update, delete: if isSuperuser()
                            || (isApprovedOrganiser()
                                && resource.data.organizerId == request.auth.uid
                                && request.resource.data.organizerId == request.auth.uid);
    }

    /* ---------------------------------------------------------------- */
    /* tickets                                                          */
    /* ---------------------------------------------------------------- */

    match /tickets/{ticketId} {
      // The buyer, the event's organiser and admins can read a ticket.
      allow get, list: if isSuperuser()
                       || (isSignedIn() && resource.data.userId == request.auth.uid)
                       || (isSignedIn() && resource.data.organizerId == request.auth.uid);

      // Tickets are normally minted server-side after payment. A signed-in user may
      // only create a ticket for themselves, and only in the 'valid' state.
      allow create: if isSuperuser()
                    || (isSignedIn()
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.status == 'valid');

      // Redemption is the organiser's job. The only field the organiser may change is
      // the status, and only from valid -> redeemed, so a ticket can never be reset
      // and reused.
      allow update: if isSuperuser()
                    || (isSignedIn()
                        && resource.data.organizerId == request.auth.uid
                        && resource.data.status == 'valid'
                        && request.resource.data.status == 'redeemed'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'redeemedAt']));

      allow delete: if isSuperuser();
    }

    /* ---------------------------------------------------------------- */
    /* coupons                                                          */
    /* ---------------------------------------------------------------- */

    match /coupons/{couponId} {
      // Signed-in only: anonymous read would let anyone enumerate every discount code.
      allow get, list: if isSignedIn();

      allow create: if isApprovedOrganiser()
                    && request.resource.data.organizerId == request.auth.uid;

      allow update, delete: if isSuperuser()
                            || (isSignedIn() && resource.data.organizerId == request.auth.uid);
    }

    /* ---------------------------------------------------------------- */
    /* offline_payments                                                 */
    /* ---------------------------------------------------------------- */

    match /offline_payments/{paymentId} {
      allow get, list: if isSuperuser()
                       || (isSignedIn() && resource.data.userId == request.auth.uid);

      // A customer may submit their own reference, always as 'pending'. They can
      // never approve their own payment.
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';

      allow update, delete: if isSuperuser();
    }

    /* ---------------------------------------------------------------- */
    /* wallet_ledger — append-only, written by trusted server code only  */
    /* ---------------------------------------------------------------- */

    match /wallet_ledger/{entryId} {
      allow get, list: if isSuperuser()
                       || (isSignedIn() && resource.data.uid == request.auth.uid);

      // Clients can never mint, alter or erase credit. All writes go through the
      // Admin SDK, which bypasses these rules.
      allow create, update, delete: if false;
    }

    /* ---------------------------------------------------------------- */
    /* payment_events — webhook intake, read by the issuance function    */
    /* ---------------------------------------------------------------- */

    match /payment_events/{providerEventId} {
      // Admins can look, to diagnose a payment that produced no ticket.
      allow get, list: if isSuperuser();

      // Nobody writes these from a client. A forged payment event would mint free
      // tickets, so this is the single most dangerous collection on the platform to
      // leave open. All writes come from the Admin SDK, which bypasses these rules.
      allow create, update, delete: if false;
    }

    match /payment_events_archive/{providerEventId} {
      allow get, list: if isSuperuser();
      allow create, update, delete: if false;
    }

    /* ---------------------------------------------------------------- */
    /* issued_payments — the idempotency marker for ticket issuance      */
    /* ---------------------------------------------------------------- */

    match /issued_payments/{providerEventId} {
      allow get, list: if isSuperuser();

      // Deleting a marker would allow a payment to be issued a second time. Denied to
      // everyone including admins — the recovery path for a genuinely stuck payment is
      // to fix it forward, never to remove the record that stops it repeating.
      allow create, update, delete: if false;
    }

    /* ---------------------------------------------------------------- */
    /* comms_deliveries — the notification log                           */
    /* ---------------------------------------------------------------- */

    match /comms_deliveries/{deliveryId} {
      // Admins only, and not the recipients themselves. Each document names an address
      // and what was sent to it, so the collection as a whole is a map of who the
      // platform's customers are — exactly the thing the organiser directory was
      // narrowed to avoid publishing.
      allow get, list: if isSuperuser();

      // Written only by the Admin SDK from `dispatch()`. A client that could forge a
      // delivery record could fake evidence that a ticket email was sent.
      allow create, update, delete: if false;
    }

    /* ---------------------------------------------------------------- */
    /* newsletter_runs — the weekly send cursor                          */
    /* ---------------------------------------------------------------- */

    match /newsletter_runs/{weekId} {
      allow get, list: if isSuperuser();

      // Written only by the Admin SDK from the cron route. A client that could edit the
      // cursor could rewind it and mail the whole list again, which is the one way to
      // turn a newsletter into a reputation incident.
      allow create, update, delete: if false;
    }

    /* Deny everything not explicitly matched above. */
    /* ---------------------------------------------------------------- */
    /* notifications                                                      */
    /* ---------------------------------------------------------------- */

    match /notifications/{id} {
      // Yours alone. A notification carries the subject of something that happened to
      // you — a refund, a suspension, a payout — so a readable-by-anyone list would be
      // a feed of other people's account events.
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Written only by the server, which dispatches them. A client that could create
      // one could forge a message from the platform to itself, and screenshots of that
      // travel further than any of us would like.
      allow create: if false;

      // The single field a recipient may change is whether they have read it.
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    /* ---------------------------------------------------------------- */
    /* login_attempts, checkout_holds — server-only                       */
    /* ---------------------------------------------------------------- */

    /* Both are written exclusively by the Admin SDK, which bypasses these rules.
       Denying every client read and write is therefore not a restriction on any
       feature — it is what stops a brute-force counter being cleared by the browser
       being brute-forced, and stops a checkout hold being released by whoever wants
       the seat. Covered by the catch-all below, and stated explicitly so that adding
       a permissive rule later is a visible decision rather than an accident. */
    /* Transfers are created, accepted and cancelled through server routes that verify
       the caller's ID token and check ticket ownership against the document. A client
       write here could hand somebody else's ticket away, or mark a transfer accepted
       without the seed rotation that stops the old holder's copy scanning. Read is
       allowed to the two parties so each can see the state of their own transfer. */
    /* Written only by the door route, which proves the scanner owns the event before a
       ticket moves. A client write could mark itself admitted to a zone it is not
       entitled to, or edit occupancy so a fire-limited room reads empty. Organisers read
       occupancy from the event document, which they already own. */
    match /zone_admissions/{id} {
      allow read, write: if false;
    }

    match /ticket_transfers/{id} {
      allow get, list: if isSignedIn() && resource.data.fromUserId == request.auth.uid;
      allow write: if false;
    }

    /* A booking is money owed and a list of named people. Both are written exclusively by
       the server: the total comes from the pricing engine, `paidMinor` from a verified
       Stripe webhook, and the guest list through a route that checks the caller owns the
       booking. A client write here could mark a £4,000 table paid, or seat fourteen people
       at a table for ten. The buyer may read their own booking so the balance, the due
       date and the guest list can render without a round trip. */
    match /hospitality_bookings/{id} {
      allow get, list: if isSignedIn() && resource.data.buyerUserId == request.auth.uid;
      allow write: if false;
    }

    /* Access codes for hidden ticket types. Denied to every client in both directions —
       a code is short and memorable, so a hash a stranger can read is a dictionary attack
       they can run offline with no throttle in the way. Verification goes through
       `/api/events/[id]/access`, which counts wrong answers. */
    match /event_access_codes/{eventId} {
      allow read, write: if false;
    }

    /* The door blocklist. Read and written exclusively through server routes that prove
       the caller owns the event being scanned. A client write here could bar somebody
       else's customers, or quietly delete the entry barring itself. */
    match /blocklist/{id} {
      allow read, write: if false;
    }

    /* Seat locks. Created inside the checkout hold transaction and deleted when the hold
       is released. A client write could take a seat without paying for it, or free a seat
       somebody has already bought. Which seats are gone is answered by
       `/api/events/[id]/seats`, which returns labels and never who is sitting in them. */
    match /seat_locks/{id} {
      allow read, write: if false;
    }

    /* Spent proof-of-work nonces. Denied to every client: a document here is what stops a
       solved challenge being replayed, so a client able to delete one gets unlimited use
       of a single proof. */
    match /attestations/{nonce} {
      allow read, write: if false;
    }

    /* Partner links and the money they earn. Written only by server routes that prove the
       caller owns the events a link earns on, and by the payment path. A client write here
       could set its own commission percentage, or credit itself somebody else's sales.
       Reads go through the API too, so a partner's own page can show their numbers
       without exposing every other partner's rate. */
    match /partner_links/{code} {
      allow read, write: if false;
    }

    /* One row per attributed order — an audit trail of money owed. Never edited, never
       deleted, never client-readable. */
    match /attributions/{id} {
      allow read, write: if false;
    }

    /* Session registrations. Written only by the route that proves the caller owns the
       ticket, inside the transaction that also moves the session's capacity count. A
       client write here could fill a workshop with other people's tickets — the cheapest
       denial of service there is against a conference — or take a place without the
       count moving, which is how a room ends up with more people than chairs. */
    match /session_registrations/{id} {
      allow read, write: if false;
    }

    /* Season passes are read publicly through the API (a pass on sale is a product), and
       written only by the route that proves the caller owns every event the pass covers —
       otherwise a pass would sell another organiser's seats. Purchases are the record that
       one payment issued a run of tickets, and are the idempotency gate for it. */
    match /season_passes/{id} {
      allow read, write: if false;
    }

    match /season_pass_purchases/{id} {
      allow read, write: if false;
    }

    /* Stream chat. Written only through the API, which re-checks the caller holds a ticket
       and takes the display name from that ticket — otherwise anybody could post as the
       organiser. Read by signed-in users: the rules cannot cheaply prove ticket ownership
       on a read, and chat is not the sensitive part. The **stream URL** is, and that never
       leaves the server without a ticket. */
    match /stream_chat/{id} {
      allow get, list: if isSignedIn();
      allow write: if false;
    }

    /* Who opened a stream, and how many times. An organiser's own audience data. */
    match /stream_views/{id} {
      allow read, write: if false;
    }

    /* Wristband bindings. Written only by routes that prove the caller owns the event.
       A client write could bind a band to somebody else's ticket, or release one so a
       barred person's band stops matching. The uniqueness of the document id is what stops
       one tag admitting two people. */
    match /wristbands/{id} {
      allow read, write: if false;
    }

    /* The media index. Written through the API, which takes the owner from a verified
       token and refuses a path that does not belong to them — Storage refuses it too. Read
       through the API so one organiser cannot enumerate another's library. */
    match /media/{id} {
      allow read, write: if false;
    }

    /* Donations and Gift Aid declarations.
       Closed to every client in both directions. A declaration carries a donor's home
       address and a statement about their tax position, and a donation record names who
       gave what to whom — neither is something one signed-in user should be able to read
       about another, and a client write could manufacture a declaration that a charity
       would then claim against. Written by the webhook and the giving API, read through
       the API scoped to the charity's own records. */
    match /donations/{id} {
      allow read, write: if false;
    }

    match /gift_aid_declarations/{id} {
      allow read, write: if false;
    }

    /* Auction lots and bids.
       Closed to clients in both directions. A client write could set its own high bid, and
       the lot list carries bidders' names and emails — an auction is public about money and
       private about people. Served through the API, which returns the price, the bid count
       and whether the reserve is met, and never who else is bidding. */
    match /auction_lots/{id} {
      allow read, write: if false;
    }

    match /auction_bids/{id} {
      allow read, write: if false;
    }

    /* Gift registry.
       Closed to clients: the running total is moved inside a transaction the webhook
       runs, and a client write could mark a £400 gift bought without paying for it. The
       contributions carry givers' names, emails and messages, which belong to the couple
       and not to the other guests — served through the API accordingly. */
    match /registry_items/{id} {
      allow read, write: if false;
    }

    match /registry_contributions/{id} {
      allow read, write: if false;
    }

    /* API keys and webhook endpoints.
       Closed absolutely. The key documents carry the HMAC a key is matched against and the
       endpoint documents carry the secret every delivery is signed with — a client that
       could read either could impersonate the platform to a customer's own server. Managed
       through /api/developer behind a signed-in session, never a bearer token: a key that
       can mint more keys is a key whose theft is unrecoverable. */
    match /api_keys/{id} {
      allow read, write: if false;
    }

    match /webhook_endpoints/{id} {
      allow read, write: if false;
    }

    match /webhook_deliveries/{id} {
      allow read, write: if false;
    }

    match /login_attempts/{id} {
      allow read, write: if false;
    }

    match /checkout_holds/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
