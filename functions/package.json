{
  "name": "ticketroyality-functions",
  "version": "1.0.0",
  "description": "Privileged server functions: ticket issuance, refunds, reconciliation.",
  "main": "lib/index.js",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions",
    "test": "cd .. && npm run test:issuance"
  },
  "dependencies": {
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.0",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
