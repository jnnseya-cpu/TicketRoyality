# Cloud Functions runtime configuration — NON-SECRET values only.
#
# This file is committed and uploaded with the functions source. `apphosting.yaml`
# configures the Next.js app on App Hosting and does NOT reach this runtime, so
# anything the functions read from process.env has to be declared here or bound as a
# secret in index.ts.
#
# SMTP_PASSWORD is deliberately absent: it is a Cloud Secret Manager secret, bound to
# the delivery function with defineSecret(). Never add it here.

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@ticketroyality.com
EMAIL_FROM=TicketRoyality <info@ticketroyality.com>
NEXT_PUBLIC_SITE_URL=https://ticketroyality.com
