{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true,
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5000
    },
    "storage": {
      "port": 9199
    }
  },
  "hosting": {
    "source": ".",
    "frameworksBackend": {
      "region": "europe-west2"
    },
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "docs/**"
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "privileged",
      "runtime": "nodejs20",
      "ignore": [
        "node_modules",
        ".git",
        "*.local"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}
