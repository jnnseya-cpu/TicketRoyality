# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Firebase (client SDK — these are safe to expose, they are protected by Security Rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Maps Static Maps API key (event location maps)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Gemini / Genkit — server-side only, never prefix with NEXT_PUBLIC_
GEMINI_API_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Bitripay (sandbox base URL: https://bitripay.com/pay/sandbox/api/v1)
BITRIPAY_BASE_URL=https://bitripay.com/pay/sandbox/api/v1
BITRIPAY_CLIENT_ID=
BITRIPAY_SECRET_ID=

# Public site URL, used to build payment return/cancel links
NEXT_PUBLIC_SITE_URL=http://localhost:9002
