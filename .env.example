# TicketRoyality — environment template
#
# Copy to .env.local for development. Every value here is EMPTY on purpose: this file
# is committed, and a real key in it is a leaked key.
#
# ─────────────────────────────────────────────────────────────────────────────
# VENDOR SURFACE — see CLAUDE.md §1
#
# Infrastructure:  Hostinger (domain, mailbox, VPS if ever needed)
#                  Firebase / Google Cloud (everything else)
#                  Vercel (available, currently unused)
# Payments:        Stripe · BitriPay/KODA
# AI:              Anthropic · Google · OpenAI
#
# Nothing else. If a feature seems to need another supplier, that is an escalation,
# not a decision. Variables for unapproved vendors are not left here as placeholders,
# because a placeholder is an invitation to wire one up.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase / Google Cloud ──────────────────────────────────────────────────
# Project settings → Your apps → Web app → SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Maps — a Google Cloud key from the same project, not a separate vendor.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server-side only, for /api/geocode. Must be a separate key: the public one above is
# referrer-restricted, and referrer restrictions do not apply to the Geocoding web
# service. Restrict this one to the Geocoding API and nothing else.
GOOGLE_MAPS_SERVER_KEY=

# App Check. The provider is reCAPTCHA Enterprise, also in the same GCP project.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Admin SDK. Unset on Firebase/Cloud Run — credentials come from the runtime service
# account automatically. Only needed to run privileged code outside Google Cloud.
FIREBASE_SERVICE_ACCOUNT=

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ticketroyality.com

# Advertising tags. Empty = the tags do not load at all.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Payments: Stripe ─────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From the Stripe dashboard when you register https://ticketroyality.com/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# ── Payments: BitriPay ───────────────────────────────────────────────────────
BITRIPAY_BASE_URL=https://bitripay.com/pay/sandbox/api/v1
BITRIPAY_CLIENT_ID=
BITRIPAY_SECRET_ID=

# ── Payments: KODA mobile money (docs/20) ────────────────────────────────────
# Publishable pk_ keys hold write:intents only and are safe in the browser.
KODA_BASE_URL=https://kodajnn.com/v1
KODA_SECRET_KEY=
KODA_WEBHOOK_SECRET=
NEXT_PUBLIC_KODA_PUBLISHABLE_KEY=

# ── AI providers ─────────────────────────────────────────────────────────────
# All three are wired. src/backend/ai/gateway.ts tries them in this order and moves
# on when one fails, is rate-limited, or answers with something that does not match
# the task's schema. Any single key is enough to run every AI feature; the other two
# are what stop one vendor's outage taking AI Studio, recommendations and
# similar-events down together.
#
# Gemini leads because it is roughly forty times cheaper per output token than Claude
# at the models configured. Cost is measured per call from the tokens the answering
# provider reports, so ACU billing stays correct when a fallback fires.
#   https://aistudio.google.com/apikey
#   https://console.anthropic.com/settings/keys
#   https://platform.openai.com/api-keys
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Email: SMTP through the Hostinger mailbox that comes with the domain ─────
# An email API (Resend, SendGrid, Postmark) would be a new vendor. SMTP is not.
# Port 465 = implicit TLS, 587 = STARTTLS; the code derives `secure` from the port.
# The Cloud Functions runtime reads the non-secret values from functions/.env
# instead — apphosting.yaml does not reach it.
#
# Two addresses exist on the domain and they are not interchangeable:
#   info@ticketroyality.com   real mailbox, receives everything. SMTP auth + From.
#   admin@ticketroyality.com  application login only, NO INBOX. Never use it here —
#                             replies and bounce notifications would go nowhere.
# IMAP (imap.hostinger.com:993) is not used; the platform sends and never reads.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@ticketroyality.com
SMTP_PASSWORD=
EMAIL_FROM=TicketRoyality <info@ticketroyality.com>

# ── Signing keys — generate per environment, never reuse across them ─────────
QR_SIGNING_KEY=
CRON_SECRET=
# Hashes public API keys. Falls back to QR_SIGNING_KEY; without either, API keys cannot
# be created at all — refused rather than hashed with an empty string.
API_KEY_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Deliberately absent, and why
#
#   RESEND_API_KEY          Email API — new vendor. SMTP above does the job.
#   SENTRY_DSN              Error tracking — new vendor. Google Cloud Error
#                           Reporting is already in the project and free at this
#                           volume.
#   TWILIO_*                SMS/WhatsApp — new vendor. Those channels are declared
#                           in the comms catalogue but cannot be delivered until a
#                           provider is approved.
#   SUMSUB_*, COMPLYADVANTAGE_*   KYC/AML — new vendors, and no code reads them.
#                           Required only if the platform ever holds funds.
#   DATABASE_URL, REDIS_URL Postgres and Redis. The launch datastore is Firestore
#                           (docs/README, "Datastore decision"); docs/08 and 19
#                           remain the unscheduled target, not a live dependency.
# ─────────────────────────────────────────────────────────────────────────────
