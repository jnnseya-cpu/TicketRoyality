# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Firebase (client SDK — these are safe to expose, they are protected by Security Rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Maps Static Maps API key (event location maps)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Gemini / Genkit — server-side only, never prefix with NEXT_PUBLIC_
GEMINI_API_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Bitripay (sandbox base URL: https://bitripay.com/pay/sandbox/api/v1)
BITRIPAY_BASE_URL=https://bitripay.com/pay/sandbox/api/v1
BITRIPAY_CLIENT_ID=
BITRIPAY_SECRET_ID=

# Public site URL, used to build payment return/cancel links
NEXT_PUBLIC_SITE_URL=http://localhost:9002

# ---------------------------------------------------------------------------
# Production. See docs/21-provider-register.md for the full register.
# ---------------------------------------------------------------------------

# Canonical origin. Set explicitly in production — a preview inheriting the
# production canonical puts staging in the search index.
NEXT_PUBLIC_SITE_URL=

# PostgreSQL (docs/08, docs/19)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Redis — QR one-time invalidation, sessions, rate limits
REDIS_URL=

# AI Gateway (docs/07 §7.5a). Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=


# KODA payment verification (docs/20)
KODA_API_KEY=
KODA_WEBHOOK_SECRET=

# Identity, AML (docs/21 §21.3)
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
COMPLYADVANTAGE_API_KEY=

# Email
RESEND_API_KEY=
EMAIL_FROM=info@ticketroyality.com

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# QR signing. Rotate per environment; never reuse production keys in staging.
QR_SIGNING_KEY=

# KODA — mobile money verification (docs/20). Server-only.
# Publishable pk_ keys hold write:intents only and are safe in the browser.
KODA_BASE_URL=https://kodajnn.com/v1
KODA_SECRET_KEY=
KODA_WEBHOOK_SECRET=
NEXT_PUBLIC_KODA_PUBLISHABLE_KEY=

# Firebase App Check — attestation (docs/11 §11.13). reCAPTCHA Enterprise site key
# from the same Google Cloud project. Public by design; the secret half stays in GCP.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Local development only. Never set in production.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
