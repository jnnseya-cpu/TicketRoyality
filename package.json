{
  "name": "ticketroyality",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --port 9002",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:links": "tsx scripts/check-links.ts",
    "report:links": "tsx scripts/link-report.ts",
    "test:issuance": "firebase emulators:exec --only firestore --project ticketroyality-test --config firebase.emulator.json \"npx tsx functions/src/issuance.test.ts\"",
    "test:delivery": "tsx functions/src/delivery.test.ts",
    "test": "npm run test:pricing && npm run test:margin && npm run test:issuance && npm run test:delivery && npm run test:ai && npm run test:comms && npm run test:newsletter",
    "grant:admin": "tsx scripts/grant-admin.ts",
    "test:ai": "tsx --conditions=react-server src/backend/ai/gateway.test.ts",
    "test:comms": "tsx --conditions=react-server src/backend/comms/dispatch.test.ts",
    "check:domain": "node scripts/check-domain.mjs",
    "test:pricing": "tsx src/shared/pricing.test.ts",
    "test:margin": "tsx --conditions=react-server src/backend/billing/margin.test.ts",
    "test:newsletter": "tsx --conditions=react-server src/backend/newsletter/newsletter.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@stripe/stripe-js": "^5.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^11.3.0",
    "firebase-admin": "^13.10.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.475.0",
    "next": "^15.5.22",
    "next-themes": "^0.4.6",
    "nodemailer": "^6.10.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "stripe": "^17.6.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.5.22",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
